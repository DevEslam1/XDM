<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main glass body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E60F1117"
                android:centerColor="#F212151D"
                android:endColor="#E60F1117"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#3D3B82F6" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Top highlight line -->
    <item
        android:top="0dp"
        android:left="16dp"
        android:right="16dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#003B82F6"
                android:centerColor="#663B82F6"
                android:endColor="#003B82F6" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
