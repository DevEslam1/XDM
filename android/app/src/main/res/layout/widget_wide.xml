<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 wide widget: single download with linear progress bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/widget_wide_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/widget_surface"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_wide_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading…"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textDirection="locale" />

        <ProgressBar
            android:id="@+id/widget_wide_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_bar"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/widget_wide_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 B/s · -- · 0%"
            android:textColor="#00D4FF"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:textDirection="locale" />

        <TextView
            android:id="@+id/widget_wide_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALL CLEAR"
            android:textColor="#00FF88"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
