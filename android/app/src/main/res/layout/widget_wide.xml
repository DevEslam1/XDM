<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 wide widget: category tag + file name + linear progress bar + live speed/ETA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/widget_wide_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/widget_surface"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_wide_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIDEO"
                android:textColor="#8B5CF6"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/widget_category_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_wide_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Downloading…"
                android:textColor="#F2F4F8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_wide_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progress="0"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress_bar"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/widget_wide_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 B/s · -- · 0%"
            android:textColor="#3B82F6"
            android:textSize="10sp"
            android:layout_marginTop="3dp"
            android:textDirection="locale" />

        <TextView
            android:id="@+id/widget_wide_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALL CLEAR"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
