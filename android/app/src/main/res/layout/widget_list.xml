<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 list widget: header + 3 download rows + footer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DMX DOWNLOADS"
            android:textColor="#00D4FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_list_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_list_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <LinearLayout
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_row1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_row1_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_row1_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_row2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_row2_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_row2_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_row3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_row3_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_row3_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_list_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No active downloads"
        android:textColor="#878787"
        android:textSize="9sp"
        android:paddingTop="2dp"
        android:textDirection="locale" />

    <TextView
        android:id="@+id/widget_list_clear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="ALL CLEAR"
        android:textColor="#00FF88"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
