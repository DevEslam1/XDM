<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 list widget: 2-tab header (Downloading / Completed) + 3 rows with per-item action controls + footer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:layoutDirection="locale">

    <!-- 2-Tab Header: DOWNLOADING vs COMPLETED -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_tab_downloading"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="DOWNLOADING"
            android:textColor="#3B82F6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_tab_active_cyan"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/widget_tab_completed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="COMPLETED"
            android:textColor="#9AA3B5"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_tab_inactive"
            android:layout_marginStart="3dp" />

        <TextView
            android:id="@+id/widget_list_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_list_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_row1_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIDEO"
                        android:textColor="#8B5CF6"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:background="@drawable/widget_category_chip"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_row1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textDirection="locale" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ProgressBar
                        android:id="@+id/widget_row1_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_row1_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_row1_action"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_row2_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUDIO"
                        android:textColor="#8B5CF6"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:background="@drawable/widget_category_chip"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_row2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textDirection="locale" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ProgressBar
                        android:id="@+id/widget_row2_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_row2_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_row2_action"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="1dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_row3_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZIP"
                        android:textColor="#8B5CF6"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:background="@drawable/widget_category_chip"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_row3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:textDirection="locale" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ProgressBar
                        android:id="@+id/widget_row3_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="5dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_row3_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_row3_action"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_list_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No downloads"
        android:textColor="#9AA3B5"
        android:textSize="9sp"
        android:paddingTop="2dp"
        android:textDirection="locale" />

    <TextView
        android:id="@+id/widget_list_clear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="ALL CLEAR"
        android:textColor="#10B981"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
