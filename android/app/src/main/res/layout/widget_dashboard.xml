<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 dashboard widget: header + 5 rows + storage/failure banners + actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_dash_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DMX DOWNLOADS"
            android:textColor="#00D4FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_dash_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="#00FF88"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_failures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 downloads failed"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:padding="4dp"
        android:background="#FF3366"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_dash_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="3dp">

        <LinearLayout
            android:id="@+id/widget_dash_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dash_row1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_dash_row1_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row1_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dash_row2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_dash_row2_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row2_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dash_row3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_dash_row3_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row3_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dash_row4_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_dash_row4_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row4_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_dash_row5_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File name"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:textDirection="locale" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/widget_dash_row5_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row5_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="9sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+0 more"
        android:textColor="#BB86FC"
        android:textSize="9sp"
        android:paddingTop="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dash_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Low storage"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:padding="4dp"
        android:layout_marginTop="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_dash_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="5dp">

        <TextView
            android:id="@+id/widget_dash_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="❚❚ PAUSE ALL"
            android:textColor="#0D0D14"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#00D4FF"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_dash_resume"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="▶ RESUME ALL"
            android:textColor="#0D0D14"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#00FF88"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_clear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="ALL CLEAR"
        android:textColor="#00FF88"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
