<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <!-- ═══ Header: Tabs + Speed ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_tab_downloading"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="DOWNLOADING"
            android:textColor="#3B82F6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:background="@drawable/widget_tab_active_cyan"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_tab_completed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="COMPLETED"
            android:textColor="#9AA3B5"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:background="@drawable/widget_tab_inactive"
            android:layout_marginStart="4dp" />

        <!-- Live speed badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_speed_badge"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/widget_dash_speed_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dash_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B/s"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginStart="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Failure Banner ═══ -->
    <TextView
        android:id="@+id/widget_dash_failures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 downloads failed"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="#EF4444"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- ═══ Task Rows ═══ -->
    <LinearLayout
        android:id="@+id/widget_dash_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/widget_dash_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/widget_dash_row1_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_status_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dash_row1_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIDEO"
                        android:textColor="#8B5CF6"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/widget_category_chip"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_dash_row1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_dash_row1_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_dash_row1_percent"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_dash_row1_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_dash_row1_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.4 MB/s"
                        android:textColor="#3B82F6"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/widget_dash_row1_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~2m 30s"
                        android:textColor="#5F6B82"
                        android:textSize="8sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_dash_row1_action"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/widget_dash_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/widget_dash_row2_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_status_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dash_row2_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUDIO"
                        android:textColor="#8B5CF6"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/widget_category_chip"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_dash_row2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_dash_row2_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_dash_row2_percent"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_dash_row2_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_dash_row2_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2 MB/s"
                        android:textColor="#3B82F6"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/widget_dash_row2_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~1m 15s"
                        android:textColor="#5F6B82"
                        android:textSize="8sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_dash_row2_action"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/widget_dash_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/widget_dash_row3_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_status_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dash_row3_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZIP"
                        android:textColor="#8B5CF6"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/widget_category_chip"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_dash_row3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_dash_row3_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_dash_row3_percent"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_dash_row3_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_dash_row3_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 KB/s"
                        android:textColor="#3B82F6"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/widget_dash_row3_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~45s"
                        android:textColor="#5F6B82"
                        android:textSize="8sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_dash_row3_action"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/widget_dash_row4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/widget_dash_row4_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_status_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dash_row4_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APK"
                        android:textColor="#8B5CF6"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/widget_category_chip"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_dash_row4_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_dash_row4_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_dash_row4_percent"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_dash_row4_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_dash_row4_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.0 MB/s"
                        android:textColor="#3B82F6"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/widget_dash_row4_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~10s"
                        android:textColor="#5F6B82"
                        android:textSize="8sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_dash_row4_action"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:id="@+id/widget_dash_row5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <View
                android:id="@+id/widget_dash_row5_dot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_status_dot"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_dash_row5_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOC"
                        android:textColor="#8B5CF6"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/widget_category_chip"
                        android:layout_marginEnd="5dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_dash_row5_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="File name"
                        android:textColor="#F2F4F8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ProgressBar
                        android:id="@+id/widget_dash_row5_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:progress="0"
                        android:max="100"
                        android:progressDrawable="@drawable/widget_progress_bar" />

                    <TextView
                        android:id="@+id/widget_dash_row5_percent"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#10B981"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_dash_row5_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_dash_row5_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.5 MB/s"
                        android:textColor="#3B82F6"
                        android:textSize="8sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/widget_dash_row5_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="~5s"
                        android:textColor="#5F6B82"
                        android:textSize="8sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_dash_row5_action"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="❚❚"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/widget_button_pause"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ +N more indicator ═══ -->
    <TextView
        android:id="@+id/widget_dash_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+0 more"
        android:textColor="#8B5CF6"
        android:textSize="9sp"
        android:textStyle="bold"
        android:paddingTop="3dp"
        android:visibility="gone" />

    <!-- ═══ Storage Warning ═══ -->
    <TextView
        android:id="@+id/widget_dash_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Low storage"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- ═══ Quick Actions ═══ -->
    <LinearLayout
        android:id="@+id/widget_dash_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_dash_pause"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="❚❚ PAUSE ALL"
            android:textColor="#3B82F6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:background="@drawable/widget_button_pause"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_dash_resume"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="▶ RESUME ALL"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:background="@drawable/widget_button_resume"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- ═══ Empty State ═══ -->
    <TextView
        android:id="@+id/widget_dash_clear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="ALL CLEAR"
        android:textColor="#10B981"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
