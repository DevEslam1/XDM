<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3 dashboard widget: header + 5 download rows (category tag + filename + progress bar + %) + banners + quick actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_dash_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XDM SIGNAL DECK"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_dash_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_failures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 downloads failed"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:background="#EF4444"
        android:layout_marginBottom="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_dash_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="2dp">

        <LinearLayout
            android:id="@+id/widget_dash_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dash_row1_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDEO"
                    android:textColor="#8B5CF6"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_category_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_dash_row1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File name"
                    android:textColor="#F2F4F8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textDirection="locale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/widget_dash_row1_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row1_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dash_row2_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUDIO"
                    android:textColor="#8B5CF6"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_category_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_dash_row2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File name"
                    android:textColor="#F2F4F8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textDirection="locale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/widget_dash_row2_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row2_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dash_row3_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZIP"
                    android:textColor="#8B5CF6"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_category_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_dash_row3_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File name"
                    android:textColor="#F2F4F8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textDirection="locale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/widget_dash_row3_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row3_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dash_row4_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APK"
                    android:textColor="#8B5CF6"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_category_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_dash_row4_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File name"
                    android:textColor="#F2F4F8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textDirection="locale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/widget_dash_row4_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row4_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_dash_row5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_dash_row5_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOC"
                    android:textColor="#8B5CF6"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_category_chip"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_dash_row5_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="File name"
                    android:textColor="#F2F4F8"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textDirection="locale" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ProgressBar
                    android:id="@+id/widget_dash_row5_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:progress="0"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <TextView
                    android:id="@+id/widget_dash_row5_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+0 more"
        android:textColor="#8B5CF6"
        android:textSize="9sp"
        android:textStyle="bold"
        android:paddingTop="2dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_dash_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Low storage"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:layout_marginTop="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_dash_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/widget_dash_pause"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="❚❚ PAUSE ALL"
            android:textColor="#3B82F6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_button_pause"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_dash_resume"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="▶ RESUME ALL"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_button_resume"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dash_clear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="ALL CLEAR"
        android:textColor="#10B981"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
