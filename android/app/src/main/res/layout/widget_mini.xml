<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 mini widget: spinning ring/badge + category pill + file name + live speed/ETA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/widget_mini_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_surface"
        android:padding="10dp">

        <ProgressBar
            android:id="@+id/widget_mini_ring"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_progress_ring"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/widget_mini_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#8B5CF6"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/widget_category_chip"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_mini_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading…"
            android:textColor="#F2F4F8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:textDirection="locale" />

        <TextView
            android:id="@+id/widget_mini_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s · --"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widget_mini_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL CLEAR"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
