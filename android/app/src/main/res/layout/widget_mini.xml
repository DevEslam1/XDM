<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 mini widget: spinning ring + file name + speed/ETA -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/widget_mini_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_surface"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/widget_mini_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_progress_ring"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_mini_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading…"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:textDirection="locale" />

        <TextView
            android:id="@+id/widget_mini_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s · --"
            android:textColor="#00FF88"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_mini_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALL CLEAR"
            android:textColor="#00D4FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
