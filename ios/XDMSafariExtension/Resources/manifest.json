{
  "manifest_version": 3,
  "name": "XDM Download Redirect",
  "version": "1.0.0",
  "description": "Redirect Safari downloads to XDM app",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
